load("@npm//:defs.bzl", "npm_link_all_packages")

# Read by `crate.from_cargo` and `npm_translate_lock` in MODULE.bazel, and the linter
# configurations read by tools/lint/linters.bzl.
exports_files([
    ".shellcheckrc",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
    "package.json",
    "pnpm-lock.yaml",
])

# node_modules/ for the root package (it has no dependencies); the SDK and the example
# link their own in their BUILD files.
npm_link_all_packages(name = "node_modules")

# `bazel run //:format` / `bazel run //:format.check` (tools/format).
alias(
    name = "format",
    actual = "//tools/format",
)

alias(
    name = "format.check",
    actual = "//tools/format:format.check",
)

# Root Starlark files for the buildifier lint aspect (tools/lint/linters.bzl). Not
# REPO.bazel: buildifier takes it for a .bzl file and asks for a module docstring.
filegroup(
    name = "starlark_files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["starlark"],
)
