# Dependency hygiene, checked on the Bazel graph instead of `cargo tree | grep`.
load(":forbidden_crates.bzl", "forbidden_crates_test")

# Every SDK embeds durable-sm: it must stay free of async runtimes and IO.
forbidden_crates_test(
    name = "durable_sm_is_sans_io",
    crate = "//crates/durable-sm",
    forbidden = [
        "async_trait",
        "futures",
        "tokio",
    ],
)

# The default (`standalone`) build must stay free of OpenTelemetry: only the opt-in
# `otel` feature pulls it in.
forbidden_crates_test(
    name = "standalone_has_no_opentelemetry",
    crate = "//durable-workflow-rs:standalone",
    forbidden = ["opentelemetry"],
)
