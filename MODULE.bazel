# Bazel build of the Cargo workspace (docs/bazel.md). Cargo.toml and Cargo.lock stay
# the source of truth: `crate.from_cargo` reads them, and every crate's BUILD.bazel
# takes its dependencies from the generated `@crates//<package>:data.bzl`.
module(name = "durable_workflow")

bazel_dep(name = "rules_rs", version = "0.2.4")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "platforms", version = "1.1.0")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.97.1",  # keep in step with rust-toolchain.toml
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    incompatible_no_root_alias_targets = True,
    incompatible_no_root_crate_data = True,
    # Every exec and target triple that takes part in a build: CI and the machines
    # we develop on. Windows is left out: nothing builds there.
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
    ],
)
use_repo(crate, "crates")

# aws-lc-sys (reqwest -> rustls -> aws-lc-rs) without its build script: AWS-LC is the
# `aws-lc` Bazel module, built by the hermetic @llvm C toolchain, and the bindings come
# from rules_rs's bindgen toolchain. This is @rules_rs//3rd_party/aws-lc-sys:
# include.MODULE.bazel, copied because its `deps` label names another hub; see
# docs/bazel.md.
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")

rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//aws_lc_sys_build_info"],
)
inject_repo(crate, "aws-lc")

# rules_rs 0.2.4 unions sqlx-core features requested by sqlx-macros-core, which is in
# Cargo.lock but not built (no `macros` feature), so sqlx-core gets `offline` and
# `any` while Cargo leaves them off. sqlx-postgres must match or it does not compile.
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = [
        "any",
        "offline",
    ],
)

# The TypeScript SDK and its example (docs/bazel.md). pnpm-lock.yaml, from the pnpm
# workspace at the root, is the source of truth for npm packages, as Cargo.lock is for
# crates.
bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.23.4")  # engines: node >= 22.18 (type stripping)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version_from = "//:package.json",
)
use_repo(pnpm, "pnpm")
