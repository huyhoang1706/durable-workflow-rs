# Check text files out with LF on every platform: the replay corpus
# (crates/durable-testkit/corpus) is compared byte for byte with its canonical
# form, and CRLF from core.autocrlf on Windows breaks that.
* text=auto eol=lf

# trybuild fixtures: their compiler output, line numbers included, is pinned in the
# .stderr files next to them, and `cargo fmt` does not reach them either. Skipped by
# `bazel run //:format` (tools/format).
durable-workflow-rs/tests/ui/** rules-lint-ignored=true
