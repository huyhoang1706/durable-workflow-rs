# direnv (https://direnv.net): puts the Bazel-managed tools of //tools:bazel_env on PATH
# when you enter the repository. Once: `bazel run //tools:bazel_env`, then `direnv allow`.
# Through the bazel-out convenience symlink, as .vscode/settings.json does; bazel_env's
# own symlink, tools/.bazel_env, reaches the same directory.
watch_file bazel-out/bazel_env-opt/bin/tools/bazel_env/bin
PATH_add bazel-out/bazel_env-opt/bin/tools/bazel_env/bin
if [[ ! -d bazel-out/bazel_env-opt/bin/tools/bazel_env/bin ]]; then
  log_error "ERROR[bazel_env.bzl]: Run 'bazel run //tools:bazel_env' to regenerate bazel-out/bazel_env-opt/bin/tools/bazel_env/bin"
fi
