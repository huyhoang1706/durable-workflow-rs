{
  "name": "@durable/typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Durable workflows in TypeScript, on the durable-workflow engine.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "durable.node"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
